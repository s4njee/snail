#include <windows.h>

101 ICON "snail.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Snail contributors\0"
            VALUE "FileDescription", "Snail mail and calendar client\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "Snail\0"
            VALUE "LegalCopyright", "MIT OR Apache-2.0\0"
            VALUE "OriginalFilename", "snail.exe\0"
            VALUE "ProductName", "Snail\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
